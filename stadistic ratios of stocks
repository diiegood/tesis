#Evaluacion del performance de las acciones

#evaluar, rendimiento anual, volatilidad sobre rendimiento, sharpe ratio y max drawdown

Freq = 52

def ann_ret(x):
    return (x+1)**Freq-1

def ann_std(x):
    return x*np.sqrt(Freq)

def ann_geo_mean(x):
    n = len(x)
    return np.exp(np.sum(np.log(1+x)) * Freq / n ) - 1

def ann_sr(x, rf):
    n = len (x)
    ret_expected = np.sum(x-rf)/n
    ret_avg = np.sum(x)/n
    std_dev = np.sqrt(np.sum((x-ret_avg)**2)/n)
    annu_ret_expected = (ret_expected + 1) ** Freq-1
    annu_std_dev = std_dev * np.sqrt(Freq)
    return annu_ret_expected/annu_std_dev

def mdd(x):
    wealth = (x+1).cumprod()
    cummax = wealth.cummax()
    drawdown = wealth/cummax -1
    return drawdown.min()


