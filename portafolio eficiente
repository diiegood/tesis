#segunda restriccion de constante no negativa
#tercera restriccion de constante de rendimiento

data_train_mean = data_train.mean()
data_train_cov_mat = data_train.cov()

def EReturn(w):
    EReturn = w @ data_train_mean
    return EReturn

def PVol(w):
    pvar = w @ data_train_cov_mat @ w
    return np.sqrt(pvar)

#Funcion para resolver la solucion optima al problema de optimizacion de portafolio de Markowitz

def MarkPortOpt (r, silent = False):
    
    def constraint1(w):
        return np.sum(w)-1.0  #restriccion de presupuesto
    def constraint2(w):
        return 1.0 - np.sum(w)  #restriccion de presupuesto
    def constraint3(w):
        return w     #restriccion no negativa
    def constraint4(w):
        diff = EReturn(w) - r
        return diff  #regresa constraint
    
    con1 = {"type": "ineq", "fun" : constraint1 }
    con2 = {"type": "ineq", "fun" : constraint2 }
    con3 = {"type": "ineq", "fun" : constraint3 }
    con4 = {"type": "ineq", "fun" : constraint4 }
    cons = ([con1, con2, con3, con4])
    
    w0 = np.ones(len(data_train.columns))

    #resolucion del problema
    solution = minimize(PVol, w0, method="SLSQP", constraints = cons)
    
    if(not silent):
        print("Solucion al problema de Markowitz con r =", round(r*100,3), "%:")
        print(solution)
        print("")
    elif (not solution["success"]): #verifica si el optimizador existente es exitoso
        print("Advertencia: el optimizador no funciona")
        
    return solution

