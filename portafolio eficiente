#Resolucion del problema de optimizacion con el sharpe ratio 

#para calcular el sharpe ratio anualizado
def AnnSR (w, data = data_train, rf = TBill_train["T-Bill"].mean()):
    excess_ret = data @ w - rf
    AnnSR = ann_ret(excess_ret.mean())/ann_std(PVol(w))
    return AnnSR

    
#Para encontrar la solucion optima del portafolio que maximize el sharpe ratio
def MaxSR(data = data_train, rf = TBill_train["T-Bill"].mean(), silent = False):
    
    #Funcion objetiva
    def SR(w):
        excess_ret = data @ w -rf
        SR = (excess_ret.mean()) / (PVol(w))
        return -SR
        
    n = len(data.columns)
    
    
#Para los bonos
    bnds = tuple((0,1) for i in range (n))
    
    #restricciones 
    
    def constraint1 (w):
        
        return np.sum(w) - 1.0 #restriccion de presupuesto
    cons = {"type": "eq", "fun": constraint1}

    w0 = np.array(np.ones(n))

    solution = minimize(SR, w0, method="SLSQP", bounds = bnds, constraints=cons)
    
    if(not silent):
        print("La solucion al problema del maximo ratio sharpe es")
        print(solution)
        print("")
    elif ( not solution["success"]):
        print("este optimizador no ha sido exitoso")

    return solution 

